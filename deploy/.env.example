# Secrets for the Narra container. Copy to .env and fill in.
# The demo is preset; remove NARRA_DEMO to run a private (non-demo) instance.

# Demo mode: no token, rate-limited, non-storing.
NARRA_DEMO=1

# Writer / voice keys (only the ones your chosen providers need).
# GEMINI_API_KEY=...
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.openai.com/v1